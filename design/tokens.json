    "muted":      { "$value": "#8b7cb8", "$description": "캡션 — 크림 위 3.6:1 이라 작은 설명 글자에는 muted-2 를 권함" },
    "muted-2":    { "$value": "#6b5b93", "$description": "설명 글자 · 비활성 탭 (크림 위 5.8:1)" },
    "muted-3":    { "$value": "#a596cc", "$description": "자리표시자 · 아주 흐린 보조" },
    "link":       { "$value": "#c96a97" },
    "link-hover": { "$value": "#8f6fd6" },
    "footer":     { "$value": "#6b7fa8" },
