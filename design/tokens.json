    "status-upcoming-line": { "$value": "#cfc6e6" },

    "accent-1": { "$value": "{color.aqua}",   "$description": "카드 accent 8색 순환(§4.1) — 8번 다음은 다시 1번" },
    "accent-2": { "$value": "{color.blue}" },
    "accent-3": { "$value": "{color.yellow}" },
    "accent-4": { "$value": "{color.purple}" },
    "accent-5": { "$value": "{color.mint}" },
    "accent-6": { "$value": "{color.lilac}" },
    "accent-7": { "$value": "{color.salmon}" },
    "accent-8": { "$value": "{color.olive}" },

    "shadow-strong": { "$value": "rgba(75,59,107,.22)", "$description": "메인 창 그림자 색" },
    "shadow":        { "$value": "rgba(75,59,107,.18)", "$description": "카드" },
    "shadow-soft":   { "$value": "rgba(75,59,107,.15)", "$description": "작은 요소" },
    "shadow-press":  { "$value": "rgba(75,59,107,.35)", "$description": "눌린 상태" },
    "divider":       { "$value": "rgba(75,59,107,.25)", "$description": "점선 구분선" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["GangwonEdu", "Do Hyeon", "Apple SD Gothic Neo", "Malgun Gothic", "sans-serif"], "$description": "페이지·섹션 큰 제목" },
    "round":   { "$value": ["CookieRun", "Jua", "Apple SD Gothic Neo", "Malgun Gothic", "sans-serif"], "$description": "소제목·버튼·칩·표 머리 (700)" },
    "body":    { "$value": ["Maplestory", "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "sans-serif"], "$description": "본문·입력 (300 / 700)" },
    "pixel":   { "$value": ["Silkscreen", "monospace"], "$description": "영문·숫자 전용 라벨 — 한글에 쓰지 않음" }
  },
  "font-size": {
    "$type": "dimension",
    "display-lg": { "$value": "30px", "$description": "페이지 제목 (30–36)" },
    "display-md": { "$value": "25px", "$description": "창 타이틀바 제목" },
    "title":      { "$value": "20px", "$description": "카드 제목 (round 700)" },
    "subtitle":   { "$value": "17px" },
    "button":     { "$value": "18px" },
    "input":      { "$value": "16px" },
    "body":       { "$value": "15px" },
    "small":      { "$value": "14px", "$description": "설명·캡션" },
    "pixel":      { "$value": "11px", "$description": "Silkscreen 라벨" },
    "pixel-xs":   { "$value": "9px" }
  },
  "line-height": {
    "$type": "number",
    "body":  { "$value": 1.7 },
    "tight": { "$value": 1.3 }
  },
  "space": {
    "$type": "dimension",
    "page-y":     { "$value": "28px" },
    "page-x":     { "$value": "20px" },
    "page-bottom": { "$value": "60px" },
    "stack":      { "$value": "18px", "$description": "창·카드 사이 세로 간격" },
    "inner":      { "$value": "12px", "$description": "카드 안 간격" },
    "window-y":   { "$value": "24px" },
    "window-x":   { "$value": "22px" },
    "card-head-y": { "$value": "8px" },
    "card-head-x": { "$value": "14px" },
    "card-body-y": { "$value": "18px" },
    "card-body-x": { "$value": "20px" },
    "grid-cell":  { "$value": "28px", "$description": "배경 격자 칸" }
  },
  "size": {
    "$type": "dimension",
    "content-max": { "$value": "1080px" },
    "doc-max":     { "$value": "980px", "$description": "문서형 화면" }
  },
  "border-width": {
    "$type": "dimension",
    "window":  { "$value": "4px" },
    "default": { "$value": "3px", "$description": "카드·칩·입력·버튼·태그" },
    "divider": { "$value": "2px" }
  },
  "radius": {
    "$type": "dimension",
    "window": { "$value": "16px" },
    "card":   { "$value": "14px" },
    "box":    { "$value": "11px", "$description": "힌트 박스" },
    "button": { "$value": "10px" },
    "field":  { "$value": "9px", "$description": "입력·칩" },
    "tag":    { "$value": "6px" },
    "pill":   { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "window": { "$value": { "color": "{color.shadow-strong}", "offsetX": "8px", "offsetY": "8px", "blur": "0px", "spread": "0px" }, "$description": "그림자는 늘 블러 0(하드 섀도우)" },
    "topic":  { "$value": { "color": "rgba(75,59,107,.2)", "offsetX": "6px", "offsetY": "6px", "blur": "0px", "spread": "0px" } },
    "card":   { "$value": { "color": "{color.shadow}", "offsetX": "5px", "offsetY": "5px", "blur": "0px", "spread": "0px" } },
    "button": { "$value": { "color": "rgba(75,59,107,.3)", "offsetX": "4px", "offsetY": "4px", "blur": "0px", "spread": "0px" } },
    "chip":   { "$value": { "color": "{color.shadow-soft}", "offsetX": "3px", "offsetY": "3px", "blur": "0px", "spread": "0px" } },
    "press":  { "$value": { "color": "{color.shadow-press}", "offsetX": "1px", "offsetY": "1px", "blur": "0px", "spread": "0px" }, "$description": "눌림 — 함께 translate(3px,3px)" }
  },
  "gradient": {
    "$type": "gradient",
    "titlebar": { "$value": [ { "color": "#f9cade", "position": 0 }, { "color": "#d6c4f5", "position": 0.55 }, { "color": "#c4d8f7", "position": 1 } ], "$description": "창 타이틀바(90도)" },
    "topic":    { "$value": [ { "color": "#f9cade", "position": 0 }, { "color": "#d6c4f5", "position": 1 } ] }
  },
  "focus": {
    "$type": "dimension",
    "width":  { "$value": "3px", "$description": "색은 color.pink-edge — 포커스 표시는 지우지 않는다" },
    "offset": { "$value": "2px" }
  },
  "duration": {
    "$type": "duration",
    "floaty": { "$value": "3s", "$description": "떠다니는 아이콘 정도만 — 과한 움직임 금지, prefers-reduced-motion 존중" }
  }
